# that is a bare `text/plain`. A client then guesses the encoding, guesses
# Latin-1, and every em-dash in the corpus arrives as "â€”".
/*.txt
  Content-Type: text/plain; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8
