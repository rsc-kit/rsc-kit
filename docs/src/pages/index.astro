---
/**
 * Landing page. Nimbus has no splash template — landing pages are just Astro
 * pages — so the hero is authored here and the cards reuse the same
 * <Card>/<CardGrid> the docs use.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Card } from "../components/ui/card";
import { CardGrid } from "../components/ui/card-grid";
import { LinkButton } from "../components/ui/link-button";
import { config } from "virtual:nimbus/config";

const tagline =
  "A file-based React Server Components router that runs on any JavaScript backend \u2014 Bun, Node, Deno, Workers \u2014 and, through a PHP adapter, inside Laravel. Not a framework: a Vite plugin and a request handler.";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-3xl w-full px-6 py-20">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <LinkButton href="/introduction" variant="primary" size="lg" icon>
          Get started
        </LinkButton>
        {config.github && (
          <LinkButton
            href={config.github}
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener"
          >
            View on GitHub
          </LinkButton>
        )}
      </div>

      <h2 class="mt-16 text-xl font-semibold text-foreground">Why this one</h2>
      <CardGrid class="mt-4">
        <Card title="No backend of its own" icon="ph:plugs-connected">
          A host is a <code>Request</code> in and a <code>Response</code> out, so binding it to Hono, Elysia or
          Workers is a line — not an adapter package per framework.
        </Card>
        <Card title="Navigations keep the page" icon="ph:arrows-left-right">
          The client sends the layout chain it holds; the server answers with only the part
          that changed. A half-typed form survives going back to it.
        </Card>
        <Card title="Frozen where it can be" icon="ph:snowflake">
          Pages that ask for nothing dynamic are rendered at build time. The rest get a frozen
          shell and streamed data, with no flag to set.
        </Card>
        <Card title="Laravel is a first-class host" icon="ph:database">
          The same engine runs behind PHP over a local socket, with middleware, policies and
          validation reaching React components as ordinary calls.
        </Card>
      </CardGrid>
    </main>
  </div>
</BaseLayout>
