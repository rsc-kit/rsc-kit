---
/**
 * Landing page. Nimbus has no splash template — landing pages are just Astro
 * pages — so the hero is authored here and the cards reuse the same
 * <Card>/<CardGrid> the docs use.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Card } from "../components/ui/card";
import { CardGrid } from "../components/ui/card-grid";
import { LinkButton } from "../components/ui/link-button";
import { config } from "virtual:nimbus/config";

const tagline =
  "React Server Components for the backend you already have. Routing, streaming, server actions and build-time prerendering — on Bun, Node, Cloudflare Workers or Laravel, with no platform to adopt.";

const mount = `app.all('*', async (c) => (await rsc(c.req.raw)) ?? c.notFound())`;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-3xl w-full px-6 py-20">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {tagline}
      </p>

      <pre class="mt-6 rounded-lg bg-card ring-1 ring-border px-4 py-3 overflow-x-auto text-sm"><code>bun create rsc-kit my-app</code></pre>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <LinkButton href="/quick-start" variant="primary" size="lg" icon>
          Quick start
        </LinkButton>
        {config.github && (
          <LinkButton
            href={config.github}
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener"
          >
            View on GitHub
          </LinkButton>
        )}
      </div>

      <h2 class="mt-16 text-xl font-semibold text-foreground">It mounts in one line</h2>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        A host is a <code>Request</code> in and a <code>Response</code> out. Register it last;
        anything your app already answers never reaches it, and anything the route manifest
        does not claim comes back <code>null</code> and stays yours.
      </p>
      <pre class="mt-4 rounded-lg bg-card ring-1 ring-border px-4 py-3 overflow-x-auto text-sm"><code>{mount}</code></pre>

      <h2 class="mt-16 text-xl font-semibold text-foreground">Why this one</h2>
      <CardGrid class="mt-4">
        <Card title="No backend of its own" icon="ph:plugs-connected">
          Add it to the Hono, Elysia, Bun or Node app you already run. There is no adapter
          package per framework, and no server you have to give up.
        </Card>
        <Card title="Navigations keep the page" icon="ph:arrows-left-right">
          The client sends the layouts it holds; the server answers with only the part that
          changed. A half-typed form survives going back to it.
        </Card>
        <Card title="Frozen where it can be" icon="ph:snowflake">
          Pages that ask for nothing dynamic are rendered at build time, automatically. The
          rest get a frozen shell and streamed data — no flag to set.
        </Card>
        <Card title="It is a Vite plugin" icon="ph:plug">
          Your Vite config still runs, so Tailwind, PostCSS and any Vite plugin work the way
          they do in any Vite app. There is no bundler of ours to configure around.
        </Card>
        <Card title="Laravel is a first-class host" icon="ph:database">
          The same engine runs behind PHP over a local socket, with middleware, policies and
          validation reaching React components as ordinary calls.
        </Card>
      </CardGrid>

      <h2 class="mt-16 text-xl font-semibold text-foreground">What it costs</h2>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        On the starter app: <strong class="text-foreground">74.7 kB</strong> of gzipped client
        JavaScript, of which rsc-kit is <strong class="text-foreground">17 kB</strong> — 7.3%.
        React is most of the rest.
      </p>
      <p class="mt-3 text-muted-foreground leading-relaxed">
        Serving a page frozen at build time costs the server about <strong class="text-foreground">25 µs</strong>,
        because it renders nothing — and a route that needs no runtime can ship
        <a href="/guides/no-javascript" class="underline">no JavaScript at all</a>.
      </p>
    </main>
  </div>
</BaseLayout>
