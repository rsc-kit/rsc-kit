{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "@types/bun",
      "vite/client"
    ]
  },
  "include": ["src/**/*", ".rsc-kit/**/*", "vite.config.ts"]
}
