{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "@types/bun",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*",
    "server.ts",
    "serve-bun.ts",
    "serve-node.ts",
    "serve-elysia.ts",
    "prerender.ts",
    "export.ts",
    "compile.ts"
  ]
}
