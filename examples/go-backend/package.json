{
  "name": "@rsc-kit/example-go-backend",
  "type": "module",
  "private": true,
  "scripts": {
    "backend": "cd backend && go run . -actions ../rsc-host-actions.json",
    "manifest": "cd backend && go run . -actions ../rsc-host-actions.json -manifest-only",
    "dev": "vite",
    "build": "bun run manifest && vite build",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@rsc-kit/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "nitro": "3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
