{
  "name": "rsc-router",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test packages/core/tests/js",
    "typecheck": "bun run --filter \"*\" typecheck",
    "check": "bun run --filter \"@rsc-router/core\" build && bun run typecheck && bun test packages/core/tests/js",
    "verify:package": "bash scripts/verify-package.sh"
  }
}
